FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# Install dependencies
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/ui/package.json ./packages/ui/
RUN pnpm install --frozen-lockfile

# Build UI then web
FROM deps AS build
COPY . .
RUN pnpm --filter @repo/ui build
RUN pnpm --filter @repo/web build

# Production image (uses Next.js standalone output)
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# standalone bundles server + node_modules; copy it to /app root
COPY --from=build /app/apps/web/.next/standalone ./
# static assets and public dir must be added alongside the standalone server
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
# newrelic config and module
COPY apps/web/newrelic.js ./apps/web/
COPY --from=deps /app/node_modules/newrelic ./node_modules/newrelic

WORKDIR /app/apps/web
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NODE_OPTIONS="--require newrelic"
EXPOSE 3000
CMD ["node", "server.js"]
